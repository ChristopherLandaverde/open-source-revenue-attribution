# Every setting the app reads. Copy to .env (gitignored) and edit; real environment variables
# win over .env. The values below are for LOCAL DEVELOPMENT. For a server, follow the
# "Production" notes on each line and docs/self-hosting.md.

# --- Core ---------------------------------------------------------------------------------
# Production: false (compose.production.yml forces it).
DEBUG=true
# Production: required, long and random. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-for-anything-but-local-dev
# Production: the domain(s) this server answers to, comma-separated, e.g. attribution.acme.example
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: the full HTTPS origin(s) people sign in from, e.g. https://attribution.acme.example
# CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------------------------
# Local Postgres from docker-compose.yml (default local dev database).
DATABASE_URL=postgres://osra:osra@localhost:5432/osra
# No Docker? Use SQLite instead (local only; `check --deploy` warns):
# DATABASE_URL=sqlite:///db.sqlite3
# Production (compose.production.yml): the PostgreSQL password. The stack builds DATABASE_URL
# from it. Use letters and digits only, e.g. python3 -c "import secrets; print(secrets.token_hex(24))"
# POSTGRES_PASSWORD=

# --- HTTPS and the reverse proxy ------------------------------------------------------------
# On by default when DEBUG is false: Secure cookies, HTTP -> HTTPS redirect. Set false only for
# a plain-HTTP private network.
# HTTPS=true
# SECURE_SSL_REDIRECT=true
# Production behind Caddy/nginx/Traefik: true, so Django trusts X-Forwarded-Proto from the proxy.
# BEHIND_PROXY=false
# HSTS max-age in seconds (0 = off). Production: start with 3600, raise to 31536000 once HTTPS works.
# SECURE_HSTS_SECONDS=0
# Opt-ins that commit your whole parent domain to HTTPS; leave false unless you mean it.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# --- Event collection (/v1/) ----------------------------------------------------------------
# Which sites' pages may send events from the browser. Default "*": any site, as Plausible,
# Umami and PostHog allow (write keys are public in page JS anyway). To restrict, list origins,
# comma-separated, scheme + host; other sites then get 403:
#   COLLECT_ALLOWED_ORIGINS=https://www.acme.example,https://app.acme.example
# COLLECT_ALLOWED_ORIGINS=*
# Most events accepted in one /v1/batch request.
# COLLECT_MAX_BATCH=500
# SDK demo page at /events/demo/ (sends synthetic events). Follows DEBUG; keep off in production.
# COLLECT_DEMO_PAGE=

# --- Attribution ----------------------------------------------------------------------------
# Optional lookback cap in days. Leave unset for no cap (first interaction to conversion).
# ATTRIBUTION_LOOKBACK_DAYS=90

# --- Operations -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# STATIC_ROOT=staticfiles
# Docker image only: run `migrate` when the container starts (default true).
# MIGRATE_ON_START=true
# Docker image only: gunicorn worker processes (default 2).
# WEB_CONCURRENCY=2
# compose.production.yml only: host port on 127.0.0.1 for the reverse proxy, image tag.
# APP_PORT=8000
# OSRA_VERSION=local
# First admin without a prompt (`createsuperuser --noinput`); remove after use.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
