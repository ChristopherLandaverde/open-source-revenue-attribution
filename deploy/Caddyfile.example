# Caddy in front of compose.production.yml. Caddy gets and renews a Let's Encrypt
# certificate for the domain automatically (ports 80 and 443 must reach this host).
# Replace the domain, then: sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
attribution.acme.example {
	encode zstd gzip
	# Caddy sets X-Forwarded-Proto and X-Forwarded-For itself; .env needs BEHIND_PROXY=true.
	reverse_proxy 127.0.0.1:8000
}
