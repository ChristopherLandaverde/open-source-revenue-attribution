# nginx in front of compose.production.yml. Certificates from certbot (or your own).
# Replace the domain and certificate paths; .env needs BEHIND_PROXY=true.
server {
    listen 80;
    server_name attribution.acme.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name attribution.acme.example;

    ssl_certificate     /etc/letsencrypt/live/attribution.acme.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/attribution.acme.example/privkey.pem;

    # CSV uploads on the Import page.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # Overwrite, never append: Django trusts this header when BEHIND_PROXY=true.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
